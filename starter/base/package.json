{
  "name": "site-platform-base",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.15 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:routes": "node --no-warnings --experimental-strip-types scripts/check-routes.mjs",
    "verify:fast": "npm run lint && npm run typecheck && npm run check:routes",
    "verify": "npm run verify:fast && npm run build",
    "block:add": "node scripts/add-block.mjs",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build && npm run clean:next-types",
    "clean:next-types": "node -e \"require('node:fs').rmSync('.next/types', { recursive: true, force: true })\"",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@keystatic/core": "0.6.9",
    "@keystatic/next": "5.0.5",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "clsx": "2.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.6.0",
    "vinext": "^1.0.0-beta.8"
  },
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@cloudflare/vite-plugin": "^1.54.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "shadcn": "4.19.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  },
  "type": "module"
}
